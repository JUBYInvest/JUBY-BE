# JUBY-BE 환경 변수 템플릿
#
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋되지 않는다.
#   cp .env.example .env
#
# 이 파일은 두 곳에서 읽힌다. 파서가 서로 달라 아래 규칙을 지켜야 한다.
#   1) Spring Boot  - application.yaml의 spring.config.import로 .properties 형식으로 읽는다.
#   2) Docker Compose - mysql 서비스의 ${...} 보간과 app 서비스의 env_file.
#
# 지켜야 할 것 (두 파서의 교집합):
#   - 값에 따옴표를 쓰지 않는다. properties 파서는 따옴표를 벗기지 않고 값에 포함시킨다.
#   - 줄 끝 주석을 쓰지 않는다. properties에서 #은 줄 맨 앞에서만 주석이다.
#     JWT_SECRET=abc # 설명  ->  값이 "abc # 설명"이 된다.
#   - 값에 역슬래시(\)를 쓰지 않는다. properties의 이스케이프 문자로 먹혀 사라진다.
#   - 값은 ASCII만 쓴다. properties는 ISO-8859-1로 읽어 한글·특수문자가 깨진다.
#   - 값에 공백을 넣지 않는다.

### DB
# 호스트는 로컬이면 127.0.0.1, EC2 배포본이면 컨테이너명 mysql이다.
DB_URL=jdbc:mysql://127.0.0.1:3306/juby?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

### MySQL 컨테이너 초기화 (docker compose가 사용)
# DB_USERNAME / DB_PASSWORD로 계정이 생성되고, MYSQL_DATABASE 스키마가 만들어진다.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=juby

### 보안
# JWT 서명 키. HS256이므로 최소 32바이트 이상으로 둔다.
JWT_SECRET=
# KIS 접근 토큰을 DB에 저장할 때 쓰는 AES 키.
AES_128=

### 소셜 로그인 (OAuth2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 네이버는 소셜 로그인과 뉴스 검색 API가 같은 값을 공유한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

### 한국투자증권(KIS) Open API
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=

### AI / 벡터 DB
# OpenAI API 키.
OPEN_API_KEY=
PINECONE_APP_KEY=

### 배포 전용 (docker compose의 app 서비스 이미지 태그)
# 로컬에서 mysql만 띄울 때는 비워 둬도 되지만, 비어 있으면 compose가 경고를 출력한다.
DOCKERHUB_USERNAME=
PROJECT_NAME=
