# deploy/docker-compose.yml 용 환경변수 템플릿.
# EC2에서 이 파일을 .env로 복사해 실제 값을 채운다. (.env는 커밋하지 않는다)
#
#   cp .env.example .env && chmod 600 .env
#
# MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE는 애플리케이션의
# DB_USERNAME / DB_PASSWORD / DB_URL 값과 반드시 일치해야 한다.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=juby
MYSQL_USER=juby
MYSQL_PASSWORD=change-me-app
